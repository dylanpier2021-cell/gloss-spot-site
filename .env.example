# ─────────────────────────────────────────────────────────────────────────────
# Local generation (.env in project root) — used by the Node build scripts.
# ─────────────────────────────────────────────────────────────────────────────

# Required to generate pages / blog posts. https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional — used by ghl-setup.js to provision GHL assets from the CLI.
GHL_API_KEY=your-ghl-key-here
GHL_LOCATION_ID=your-location-id

# Optional — Bing/IndexNow instant indexing ping. https://www.indexnow.org
INDEXNOW_KEY=your-indexnow-key

# ─────────────────────────────────────────────────────────────────────────────
# Vercel environment (set in the Vercel dashboard, NOT committed) — used by the
# serverless functions in api/. The booking flow is broken without this one:
#   api/ghl-free-slots.js     reads calendar availability
#   api/ghl-create-booking.js upserts the contact + books the appointment
#   api/ghl-feedback.js       posts /feedback submissions into GHL
# GHL Private Integration Token (Settings → Private Integrations).
# ─────────────────────────────────────────────────────────────────────────────
GHL_PIT_TOKEN=pit-your-private-integration-token

# ─────────────────────────────────────────────────────────────────────────────
# Lead scraper (Python, lead_scraper.py) — optional, not part of the website.
# ─────────────────────────────────────────────────────────────────────────────
# https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=your_yelp_api_key_here
